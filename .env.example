# API key for the Groq LLM provider
GROQ_API_KEY=your_groq_api_key_here

# Model used for generation (second stage). Override if needed.
# See https://console.groq.com/docs/models for available model names.
GROQ_MODEL=llama-3.1-8b-instant

# Model used for classification (first stage). If not set, falls back to GROQ_MODEL.
CLASSIFIER_MODEL=llama-3.1-8b-instant

# Confidence threshold for treating an intent as reliable. Below this, intent is treated as 'unclear'.
CONFIDENCE_THRESHOLD=0.7

# Optional custom path for the routing log (JSON Lines format).
# ROUTE_LOG_PATH=logs/route_log.jsonl
